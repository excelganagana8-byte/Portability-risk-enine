PORT=3000
NODE_ENV=development
PRE_SCANNER_USER_AGENT=PRE-Scanner/0.1 (+https://example.com/pre-scan-policy)
PRE_MAX_PAGES=25
PRE_MAX_PRODUCTS=100
PRE_MAX_COLLECTIONS=50
PRE_MAX_CONCURRENCY=3
PRE_REQUEST_TIMEOUT_MS=10000
PRE_SCAN_TIMEOUT_MS=90000
PRE_MAX_RESPONSE_BYTES=10485760
PRE_RATE_LIMIT_PER_HOUR=10
PRE_ALLOWED_PORTS=80,443
LOG_LEVEL=info
